# Copie este arquivo para ".env" (que não é enviado ao GitHub) e preencha.
# Exemplo para uma conta Outlook/Hotmail com senha de aplicativo:
EMAIL_HOST=smtp-mail.outlook.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=seu_email@hotmail.com
EMAIL_HOST_PASSWORD=senha_de_aplicativo
DEFAULT_FROM_EMAIL=Gestão da Igreja <seu_email@hotmail.com>

# Exemplo para Gmail (senha de aplicativo de 16 letras, sem espaços):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=seu_email@gmail.com
# EMAIL_HOST_PASSWORD=senha_de_aplicativo
