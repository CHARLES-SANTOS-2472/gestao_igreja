{
  "name": "Gestao da Igreja",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "containerEnv": {
    "DJANGO_DEBUG": "0",
    "DJANGO_ALLOWED_HOSTS": ".app.github.dev,localhost,127.0.0.1",
    "DJANGO_CSRF_TRUSTED_ORIGINS": "https://*.app.github.dev",
    "DJANGO_SSL_REDIRECT": "0",
    "DJANGO_HSTS_SECONDS": "0"
  },
  "postCreateCommand": "pip install -r requirements.txt && python manage.py migrate",
  "postStartCommand": "nohup python manage.py runserver 0.0.0.0:8000 --noreload --insecure > /tmp/server.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Gestao da Igreja", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "batisteo.vscode-django"] }
  }
}
